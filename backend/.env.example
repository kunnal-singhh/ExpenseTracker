PORT=5000
NODE_ENV=development

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret

# Comma-separated frontend origins allowed to call this API.
# Local: http://localhost:5173
# Production example: https://your-frontend.vercel.app
CLIENT_URL=http://localhost:5173

# Optional AI providers. GROQ is preferred by /api/ai/chat when present.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional email provider for verification and budget alerts.
BREVO_API_KEY=
EMAIL_FROM=noreply@expense-tracker.app
